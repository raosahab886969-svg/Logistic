{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "devadflogistic9001"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"ls_adb_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_adb'"
		},
		"ls_sql_database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_database'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://devenvstorageaccount9001.dfs.core.windows.net/"
		},
		"ls_adb_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1023-020634-9paw0omr"
		},
		"ls_sql_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "harrynewserver1.database.windows.net"
		},
		"ls_sql_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "harrynewdatabase"
		},
		"ls_sql_database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "harrynewuser"
		},
		"Every_6_properties_parent_pl_parameters_P_Configuration_Table": {
			"type": "string",
			"defaultValue": "dbo.CONFIG"
		},
		"Every_6_properties_parent_pl_parameters_P_Frequency_In_Mniutes": {
			"type": "string",
			"defaultValue": "360"
		},
		"Everyday_Once_properties_parent_pl_parameters_P_Configuration_Table": {
			"type": "string",
			"defaultValue": "dbo.CONFIG"
		},
		"Everyday_Once_properties_parent_pl_parameters_P_Frequency_In_Mniutes": {
			"type": "string",
			"defaultValue": "1440"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "devadflogistic9001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"ls_adb_accessToken": {
						"value": "[parameters('ls_adb_accessToken')]"
					},
					"ls_sql_database_password": {
						"value": "[parameters('ls_sql_database_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_adb_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_adb_properties_typeProperties_existingClusterId')]"
					},
					"ls_sql_database_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_server')]"
					},
					"ls_sql_database_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_database')]"
					},
					"ls_sql_database_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_userName')]"
					},
					"Every_6_properties_parent_pl_parameters_P_Configuration_Table": {
						"value": "[parameters('Every_6_properties_parent_pl_parameters_P_Configuration_Table')]"
					},
					"Every_6_properties_parent_pl_parameters_P_Frequency_In_Mniutes": {
						"value": "[parameters('Every_6_properties_parent_pl_parameters_P_Frequency_In_Mniutes')]"
					},
					"Everyday_Once_properties_parent_pl_parameters_P_Configuration_Table": {
						"value": "[parameters('Everyday_Once_properties_parent_pl_parameters_P_Configuration_Table')]"
					},
					"Everyday_Once_properties_parent_pl_parameters_P_Frequency_In_Mniutes": {
						"value": "[parameters('Everyday_Once_properties_parent_pl_parameters_P_Frequency_In_Mniutes')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}